{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenMCP",
  "version": "0.1.0",
  "identifier": "com.yaska.openmcp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMCP",
        "width": 1280,
        "height": 780,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
